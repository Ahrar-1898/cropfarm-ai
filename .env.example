# Local SQLite is used when DATABASE_URL is blank.
DATABASE_URL=
SECRET_KEY=
APP_ENV=development
# FLASK_ENV is retained as a fallback for older deployment configurations.
FLASK_ENV=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
# Apply schema changes with `flask --app app db upgrade`.
AUTO_CREATE_DB=false
COOKIE_SECURE=false
WEATHER_LOCATION=
# Optional CA bundle for networks with a custom TLS certificate.
REQUESTS_CA_BUNDLE=
CURL_CA_BUNDLE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=
REPORT_FONT_PATH=
RATELIMIT_STORAGE_URI=memory://

# Model paths are fixed in app.py: models/crop_disease_model.keras and
# models/class_indices.json. Uploads and reports use instance/uploads and
# instance/reports. The React preview currently has no backend API URL setting.
